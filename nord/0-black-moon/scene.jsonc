// The scene for nord/0-black-moon. Nothing is cut out of this still: two effects
// work on two areas of it. It has no arrive part, so the theme's intro clip
// still plays when the background appears.
{
  "still": "nord/0-black-moon.jpg",
  "sha256": "6873fbf7d4cbb9a39604094dd8d804eb6d231e63ecf56e5c297aae90358eff81",

  // An area is a place in the still and a grey picture of its shape: white
  // where an effect works in full, black where the still is left alone.
  // cut.py makes both.
  "areas": [
    { "name": "sky", "mask": "pieces/sky.png", "at": [0.0, 0.0, 1.0, 0.875] },
    { "name": "sea", "mask": "pieces/sea.png", "at": [0.26, 0.855, 0.74, 0.145] }
  ],

  // Repeats for as long as the desktop may move.
  "idle": {
    "frames_a_second": 12,
    // The stars and the dust of the rings brighten and dim, each in its own time.
    "sky": { "twinkle": { "amount": 0.7, "size": 0.003, "seconds": 7 } },
    // The surf is pushed gently back and forth.
    "sea": { "drift": { "amount": [0.005, 0.0015], "size": 0.07, "seconds": 9 } }
  }
}
