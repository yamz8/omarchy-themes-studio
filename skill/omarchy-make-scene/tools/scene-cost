#!/usr/bin/python
"""Estimate what a scene costs to draw, by timing OWE drawing it to files against drawing the still alone.

Usage: scene-cost <scene.jsonc> [--wide 2560] [--tries 3] [--still PATH]

Draws a few frames of the idle part at a screen's size and a few of a scene with nothing in it,
and reports the extra time a frame takes. This is an estimate made off the screen: it also times
reading the frame back and writing it to a file, and other programs using the graphics chip skew
it. What a scene really costs is measured with it playing on the desktop. Use this to catch a
scene that is far too heavy before it gets that far, and --wide to match the user's screen in
pixels (2560 is a 1440p screen; 3840 is 4K).
"""

import statistics
import subprocess
import sys
import tempfile
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import scenefile

FEW, MORE = 2, 10


def main():
  path, opt = scenefile.arguments(__doc__, {"wide": 2560, "tries": 5, "still": None})
  told = scenefile.info(path, opt["still"])
  scene = scenefile.read(path)
  rate = scenefile.fps(scene)
  size = scenefile.size_for(told, opt["wide"])
  with tempfile.TemporaryDirectory(prefix="scene-cost-") as work:
    bare = Path(work) / "bare"
    bare.mkdir()
    (bare / "scene.jsonc").write_text('{"still": "%s"%s}' % (scene["still"], ', "sha256": "%s"' % scene["sha256"] if scene.get("sha256") else ""))
    draw = lambda which, count: once(which, told["still_path"], size, rate, count, work)
    draw(path, FEW)  # the first run also fills caches
    # The still alone and the scene are timed in turn, so whatever else the machine is doing falls on both.
    plain, full = [], []
    for _ in range(opt["tries"]):
      plain.append((draw(bare / "scene.jsonc", MORE) - draw(bare / "scene.jsonc", FEW)) / (MORE - FEW) * 1000)
      full.append((draw(path, MORE) - draw(path, FEW)) / (MORE - FEW) * 1000)
  own = sorted(f - p for f, p in zip(full, plain))
  extra, low, high = max(0.0, statistics.median(own)), own[0], own[-1]
  budget = 1000 / rate
  print(f"at {size[0]}x{size[1]}, {rate} frames a second:")
  print(f"  the still alone   {statistics.median(plain):6.1f} ms a frame (drawing, reading back and writing the file)")
  print(f"  the scene         {statistics.median(full):6.1f} ms a frame")
  print(f"  the scene's own   {extra:6.1f} ms a frame ({low:.0f} to {high:.0f} over {opt['tries']} tries), {extra / budget:.0%} of the {budget:.0f} ms between frames")
  if extra / budget > 0.5:
    print("  Heavy: more than half of every frame's time goes to the scene, and a video is likely cheaper. Find what the shader works out again for every pixel.")
  elif extra / budget > 0.25:
    print("  On the heavy side. Measure it playing before relying on it, and try fewer frames a second.")
  else:
    print("  Light, as far as this can tell: it cannot see less than about 10 ms a frame.")
  print("  An estimate only. The measurement that counts is the scene playing on the desktop.")


def once(scene, still, size, rate, count, work):
  """Seconds OWE takes to draw `count` frames of the scene to files."""
  out = tempfile.mkdtemp(prefix="frames-", dir=work)
  started = time.perf_counter()
  result = subprocess.run(["owe", "scene", "frame", str(scene), "--still", str(still), "--part", "idle", "--at", "1", "--frames", str(count), "--fps", str(rate),
                           "--size", f"{size[0]}x{size[1]}", "--ppm", "--out", out], capture_output=True, text=True)
  took = time.perf_counter() - started
  for file in Path(out).glob("*.ppm"):
    file.unlink()
  if result.returncode != 0:
    scenefile.stop(f"OWE could not draw the scene:\n{result.stderr.strip()}")
  return took


if __name__ == "__main__":
  main()
