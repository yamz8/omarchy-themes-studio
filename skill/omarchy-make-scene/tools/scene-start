#!/usr/bin/python
"""Start a scene for a still: find the picture, take its checksum, and write an empty scene file for it.

Usage: scene-start [still] [--into FOLDER]

With no still, the background on screen now is used. The scene is written to FOLDER/scene.jsonc;
without --into that is a folder named after the still in the current directory. The still itself
is never copied, converted or renamed: the scene names it and holds its SHA-256.
"""

import hashlib
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import scenefile

STATE = Path.home() / ".local/state/omarchy/current"
KINDS = {".jpg", ".jpeg", ".png", ".bmp", ".webp"}
TEMPLATE = """// The scene for {name}. With nothing moving it is that picture exactly.
// The format is set out in format.md beside the omarchy-make-scene skill.
{{
  // The still this scene belongs to, and its checksum. OWE refuses the scene for any other picture.
  "still": "{name}",
  "sha256": "{sha}",

  // Places in the still. "at" is left, top, width and height as shares of the picture, 0 to 1.
  // "mask" is a grey picture of the place's shape, white where an effect works in full; leave it
  // out and the area is its whole rectangle.
  "areas": [
    // {{ "name": "sky", "mask": "pieces/sky.png", "at": [0, 0, 1, 0.6] }}
  ],

  // Shaders of the scene's own, each a file beside it, with the values it has unless a part says otherwise.
  "effects": [
    // {{ "name": "waves", "shader": "effects/waves.glsl", "values": {{ "amount": 0.016, "seconds": 16 }} }}
  ],

  // Shapes cut from the still that move, back to front.
  "pieces": [
    // {{ "name": "bird", "picture": "pieces/bird.png", "behind": "pieces/bird-behind.png", "at": [0.4, 0.3, 0.05, 0.08] }}
  ],

  // Repeats for as long as the desktop may move. Everything in it passes through rest.
  "idle": {{
    "frames_a_second": 24
    // , "sky": {{ "twinkle": {{ "amount": 0.6, "seconds": 7 }} }}
    // , "bird": {{ "y": {{ "swing": 0.004, "seconds": 8 }} }}
  }}

  // Add an "arrive" part only if the scene should also play as the background's intro:
  // , "arrive": {{ "frames_a_second": 30, "seconds": 4, "bird": {{ "fade": {{ "from": 0, "after": 1, "for": 0.5 }} }} }}
}}
"""


def main():
  args = sys.argv[1:]
  into = None
  if "--into" in args:
    at = args.index("--into")
    if at + 1 >= len(args):
      scenefile.stop(__doc__)
    into = Path(args[at + 1])
    del args[at:at + 2]
  if len(args) > 1 or (args and args[0].startswith("-")):
    scenefile.stop(__doc__)
  still = Path(args[0]).expanduser() if args else STATE / "background"
  still = still.resolve()
  if not still.is_file() or still.suffix.lower() not in KINDS:
    scenefile.stop(f"{still} is not a still picture. A scene belongs to a jpg, png, webp or bmp background; a video background needs none.")

  name = f"{theme_of(still)}/{still.name}" if theme_of(still) else still.name
  sha = hashlib.sha256(still.read_bytes()).hexdigest()
  folder = into or Path.cwd() / still.stem
  target = folder / "scene.jsonc"
  if target.exists():
    scenefile.stop(f"{target} is already there; it was left as it is.")
  folder.mkdir(parents=True, exist_ok=True)
  target.write_text(TEMPLATE.format(name=name, sha=sha))

  theme = theme_of(still)
  print(f"still   {still}")
  print(f"        named {name} in the scene, SHA-256 {sha}")
  print(f"scene   {target}")
  print(f"look    owe scene frame {target} --still {still} --at 2 --out moment.png")
  print("To play it, the scene's folder goes beside the still the desktop is showing:")
  print(f"        {STATE}/theme/backgrounds/scenes/{still.stem}/")
  if theme:
    print("That folder is rebuilt each time a theme is applied. To keep the scene, put it here too:")
    print(f"        {Path.home()}/.config/omarchy/themes/{theme}/backgrounds/scenes/{still.stem}/")


def theme_of(still):
  """The theme a still belongs to, when its place says so: .../themes/<theme>/backgrounds/<file>, or the current theme."""
  if still.parent.name != "backgrounds":
    return ""
  owner = still.parent.parent
  if owner.parent.name == "themes":
    return owner.name
  if owner == (STATE / "theme").resolve():
    recorded = STATE / "theme.name"
    return recorded.read_text().strip() if recorded.is_file() else ""
  return ""


if __name__ == "__main__":
  main()
