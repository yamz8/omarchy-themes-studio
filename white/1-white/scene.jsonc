// The scene for white/1-white: a slow wave travels outward through the folds
// of the paper and moves each one across its own edge. Nothing is cut out of
// the still. One effect of the scene's own moves the picture; folds.py worked
// out from the still where the folds run and wrote that into the shader.
{
  "still": "white/1-white.webp",
  "sha256": "2f2f42f7ad3ba978951f137e214404c2c4a52318a60105ded5e74ddfe8ed80f2",

  // The whole picture. An area with no picture of its shape is its rectangle.
  "areas": [
    { "name": "picture", "at": [0, 0, 1, 1] }
  ],

  // The scene's own effect, and the values it has unless a part says otherwise.
  // A fold moves at most 0.0056 of the still's height, 12 pixels of a 4K
  // screen, and one wave is 0.42 of the height long. One wave passes each
  // place in a cycle, so the cycle has no seam.
  "effects": [
    { "name": "folds", "shader": "effects/folds.glsl", "values": { "amount": 0.005556, "wave": 0.416667, "seconds": 12 } }
  ],

  // Repeats for as long as the desktop may move.
  "idle": {
    "frames_a_second": 24,
    "picture": { "folds": {} }
  }
}
